NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Phase 2: Google Calendar ---
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only — Supabase Project Settings -> API -> service_role key.
# This bypasses row-level security. Never expose it to the browser,
# never prefix it with NEXT_PUBLIC_, never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Google sign-in ---
# The only email allowed to actually use the app after signing in with
# Google. Anyone else who signs in gets immediately signed back out.
OWNER_EMAIL=you@example.com

# --- Phase 3: email + automation (add to .env.local AND Vercel env) ---
# https://resend.com — verify your sending domain first
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=Your Name <hello@yourdomain.com>

# Replies go here. Also the address allowed to sign in, if you use OWNER_EMAIL.
OWNER_EMAIL=you@yourdomain.com

# Long random strings (e.g. `openssl rand -hex 32`)
CRON_SECRET=change-me
WEBHOOK_SECRET=change-me-too

# Server-only TypeSafe key for Leads > More actions > Analyze with JEV.
TYPESAFE_API_KEY=
